# ── Server ────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000

# ── MongoDB Atlas ─────────────────────────────────────────────────────────
# Atlas → Cluster → Connect → Drivers → copy the SRV string here.
# Replace <user>/<password> with your database user and add the database name.
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/mrskariza?retryWrites=true&w=majority

# ── Authentication ────────────────────────────────────────────────────────
# Use a long random string (e.g. `openssl rand -hex 32`)
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_IN=12h

# Comma-separated list of allowed frontend origins (local + deployed)
CLIENT_URL=http://localhost:5173

# ── Initial Super Admin (used by `npm run seed`) ──────────────────────────
SUPER_ADMIN_NAME=Mrskariza Super Admin
SUPER_ADMIN_EMAIL=superadmin@mrskariza.school
SUPER_ADMIN_PASSWORD=change-me-to-a-strong-password
